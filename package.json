{
  "name": "kidhub",
  "private": true,
  "description": "KidHub creative activities, games, art, music, and learning - static site and development tooling",
  "scripts": {
    "test": "node tools/run-tests.cjs",
    "test:a11y": "node test-a11y.cjs",
    "serve": "python -m http.server 8000",
    "build": "python build.py",
    "test:activities": "node tools/run-tests.cjs test-adventures.cjs test-expanded-core.cjs",
    "import:games": "python tools/import_games.py && python build.py",
    "test:resources": "node tools/run-tests.cjs test-resources.cjs test-reliability.cjs",
    "test:release": "node tools/run-tests.cjs test-polish.cjs test-dashboard.cjs test-resources.cjs test-reliability.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "html-validate": "^9.0.0",
    "playwright": "^1.50.0"
  }
}
